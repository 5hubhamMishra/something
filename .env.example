# Copy to .env.local and fill in real values. .env.local is gitignored —
# never commit real secrets. This file only documents the variable names.

# The single account allowed to log in.
SITE_USERNAME=

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Address that receives password-reset OTP codes.
OWNER_EMAIL=

# Auto-filled by `vercel env pull .env.local` once the Resend integration
# (Vercel Marketplace) is installed on this project.
RESEND_API_KEY=
# Optional: a "from" address on a domain you've verified with Resend.
# Defaults to onboarding@resend.dev if unset (works with no setup).
RESEND_FROM_EMAIL=

# Set once the Upstash for Redis integration (Vercel Marketplace) is
# installed on this project. Vercel provisions these as write-only
# "Sensitive" variables, so `vercel env pull` can't retrieve them — copy
# the values from the database's page under the Storage tab instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=
